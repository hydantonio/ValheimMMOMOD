<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ValheimMMOMOD</AssemblyName>
    <RootNamespace>ValheimMMOMOD</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>build/</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup><Compile Include="src/*.cs" /><EmbeddedResource Include="assets/localization/*.json" LogicalName="MMOMOD.Localization.%(Filename)%(Extension)" /><EmbeddedResource Include="assets/menu-logo.png" LogicalName="MMOMOD.MenuLogo.png" /></ItemGroup>
  <!-- Riferimenti BepInEx -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimDir)/BepInEx/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimDir)/BepInEx/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx.Harmony">
      <HintPath>$(ValheimDir)/BepInEx/core/BepInEx.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Riferimenti Unity Engine -->
  <ItemGroup>
    <Reference Include="assembly_guiutils"><HintPath>$(ValheimDir)/Valheim_Data/Managed/assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(ValheimDir)/Valheim_Data/Managed/Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.JSONSerializeModule"><HintPath>$(ValheimDir)/Valheim_Data/Managed/UnityEngine.JSONSerializeModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimDir)/Valheim_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
